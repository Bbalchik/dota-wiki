# Database connection URL
# For local SQLite: file:./dev.db
# For production PostgreSQL (Neon, Supabase, Render): postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL="file:./dev.db"

# Session & Auth
SESSION_SECRET="generate-a-secure-random-string-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Optional APIs:
# Stratz API Token (get from https://stratz.com/api)
STRATZ_API_TOKEN=""

# Steam Web API Key (optional, get from https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=""
